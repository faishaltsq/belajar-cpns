# ── Database (Neon Postgres) ──────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
POSTGRES_URL=postgres://user:pass@host/db?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED in production. The app throws at startup if this is unset in prod.
JWT_SECRET=generate-with-openssl-rand-base64-32

# ── Email delivery ────────────────────────────────────────────────────────
# Sender address. MUST be on a domain you control with SPF + DKIM + DMARC
# published, or Gmail/Outlook will file OTP mail under spam.
MAIL_FROM=noreply@lolosin.com

# Provider utama: Resend. Wajib verifikasi domain di dashboard Resend dulu
# (Domains -> Add Domain -> pasang record DNS yang diberikan), lalu isi:
RESEND_API_KEY=re_xxxxxxxxxxxx

# Fallback: SMTP. Dipakai otomatis kalau Resend gagal dan SMTP terkonfigurasi,
# supaya gangguan Resend tidak mematikan pendaftaran.
# Catatan: kalau SMTP_HOST kosong, dipakai Gmail dan From: dipaksa ke SMTP_USER
# (Gmail menolak pengirim palsu). Relay menerima From: dari MAIL_FROM.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-relay-login
# SMTP_PASS=your-relay-smtp-key

# ── App ───────────────────────────────────────────────────────────────────
# Canonical origin. Used to build the email verification link, so it must be
# the real public domain — never a *.vercel.app preview URL.
NEXT_PUBLIC_APP_URL=https://lolosin.com

# ── Admin ─────────────────────────────────────────────────────────────────
# No default. Unset means every admin route returns 401.
ADMIN_PIN=change-me
